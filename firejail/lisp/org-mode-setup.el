;;; org-mode-setup.el --- Setup and tangle NorAng org-mode.org for Emacs-Jail -*- lexical-binding: t; -*-

;;; Commentary:
;; Writes org-mode.org into the user workspace, opens it in a new buffer,
;; loads it in Emacs with Org mode, and tangles source blocks with C-c C-v C-t
;; to generate org-mode.el in the same directory as org-mode.org.

(require 'org)
(require 'ob)
(require 'ob-tangle)

;; Load available Babel languages safely
(condition-case nil (require 'ob-emacs-lisp) (error nil))
(condition-case nil (require 'ob-python) (error nil))
(condition-case nil (require 'ob-shell) (error nil))

(org-babel-do-load-languages
 'org-babel-load-languages
 '((emacs-lisp . t)
   (python . t)
   (shell . t)))

;; Configure safe environment
(setq org-babel-python-command (if (executable-find "python3") "python3" "python")
      org-confirm-babel-evaluate nil
      make-backup-files nil
      auto-save-default nil
      create-lockfiles nil)

;; Ensure keybinding C-c C-v C-t is bound to org-babel-tangle
(define-key org-mode-map (kbd "C-c C-v C-t") #'org-babel-tangle)

(defconst emacs-jail--org-mode-content-b64
  ""
  "Embedded base64 content of NorAng org-mode.org.")

(defun emacs-jail--get-org-content (&optional input-file)
  "Retrieve the org-mode.org document content from disk or embedded fallback."
  (let ((script-dir (file-name-directory (or load-file-name buffer-file-name default-directory))))
    (cond
     ((and input-file (file-exists-p input-file))
      (with-temp-buffer
        (insert-file-contents input-file)
        (buffer-string)))
     ((and script-dir (file-exists-p (expand-file-name "org-mode.org" script-dir)))
      (with-temp-buffer
        (insert-file-contents (expand-file-name "org-mode.org" script-dir))
        (buffer-string)))
     ((file-exists-p "~/.emacs_jail/lisp/org-mode.org")
      (with-temp-buffer
        (insert-file-contents "~/.emacs_jail/lisp/org-mode.org")
        (buffer-string)))
     ((file-exists-p "/home/self/Downloads/org-mode.org")
      (with-temp-buffer
        (insert-file-contents "/home/self/Downloads/org-mode.org")
        (buffer-string)))
     (t
      (base64-decode-string emacs-jail--org-mode-content-b64)))))

(defun emacs-jail--resolve-workspace (&optional custom-ws)
  "Locate or create the target workspace directory."
  (let ((ws (or custom-ws
                (cond
                 ((file-directory-p (expand-file-name "workspace" default-directory))
                  (expand-file-name "workspace" default-directory))
                 ((string-match-p "/workspace/?$" (expand-file-name default-directory))
                  (expand-file-name default-directory))
                 ((file-directory-p (expand-file-name "~/workspace"))
                  (expand-file-name "~/workspace"))
                 (t default-directory)))))
    (unless (file-directory-p ws)
      (make-directory ws t))
    (file-name-as-directory ws)))

(defun emacs-jail--parse-setup-args (args)
  "Parse command line arguments for org-mode setup runner."
  (let (ws input)
    (while args
      (let ((arg (pop args)))
        (cond
         ((string-equal arg "--workspace") (setq ws (pop args)))
         ((string-equal arg "--input") (setq input (pop args))))))
    (list ws input)))

(defun emacs-jail-setup-org-mode (&optional custom-workspace custom-input)
  "Write org-mode.org into workspace, open in a buffer, and tangle to org-mode.el."
  (interactive)
  (let* ((ws (emacs-jail--resolve-workspace custom-workspace))
         (org-file (expand-file-name "org-mode.org" ws))
         (expected-el (expand-file-name "org-mode.el" ws))
         (content (emacs-jail--get-org-content custom-input)))

    ;; 1. Write the content into user workspace
    (let ((coding-system-for-write 'utf-8-unix))
      (with-temp-file org-file
        (insert content)))
    (message "WORKSPACE_WRITE_SUCCESS: %s" org-file)

    ;; 2. Open it in a new buffer and load in Emacs
    (let ((buf (find-file-noselect org-file)))
      (with-current-buffer buf
        (org-mode)
        (message "BUFFER_OPEN_SUCCESS: %s" (buffer-name buf))

        ;; 3. Tangle with C-c C-v C-t (org-babel-tangle)
        (let ((tangled-files (org-babel-tangle)))
          (save-buffer)
          (if (file-exists-p expected-el)
              (message "BABEL_TANGLE_SUCCESS: Created %s (%d bytes)"
                       expected-el
                       (file-attribute-size (file-attributes expected-el)))
            (message "BABEL_TANGLE_WARNING: org-mode.el not found at %s" expected-el))
          (message "TANGLED_FILES: %S" (or tangled-files '()))))

      ;; Display buffer if in interactive mode
      (unless noninteractive
        (switch-to-buffer buf))
      buf)))

;; Auto-run when executed in headless batch mode or invoked via command-line
(let* ((parsed (emacs-jail--parse-setup-args argv))
       (ws (nth 0 parsed))
       (input (nth 1 parsed)))
  (if noninteractive
      (condition-case err
          (progn
            (emacs-jail-setup-org-mode ws input)
            (kill-emacs 0))
        (error
         (message "SETUP_ERROR: %s" (error-message-string err))
         (kill-emacs 1)))
    (emacs-jail-setup-org-mode ws input)))

(provide 'org-mode-setup)
;;; org-mode-setup.el ends here
